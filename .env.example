# Copie para .env (na raiz do projeto) e preencha. O .env nunca vai para o git.
# Use UM dos dois destinos: o server (padrão) OU um repositório Git privado.

# ------------------------------------------------------------------ criptografia (recomendado)
# Mesma chave em TODOS os seus PCs. Gere uma vez com:
#   python src/components/remote_client.py synckey
# Sem ela o sync funciona, mas o conteúdo vai só compactado, sem sigilo.
SYNC_KEY=

# ------------------------------------------------------------------ destino 1: server (padrão)
# URL pública do ClaudeMemorySync-Server (só o domínio também serve)
SERVER_URL=https://seu-app.up.railway.app
# Par Ed25519 DESTE PC. Gere com:
#   python src/components/remote_client.py keygen pc-nome-deste-pc
# e coloque a linha pública em CLIENT_PUBLIC_KEYS no server.
CLIENT_ID=pc-nome-deste-pc
CLIENT_PRIVATE_KEY=

# ------------------------------------------------------------------ destino 2: repositório Git (sem server)
# Descomente para usar um repositório Git PRIVADO e vazio no lugar do server.
# O git deste PC precisa acessar a URL sem pedir senha (SSH ou Credential Manager).
# SYNC_BACKEND=git
# GIT_REPO_URL=git@github.com:voce/claude-memory-data.git
# GIT_BRANCH=main
# CLIENT_ID=pc-nome-deste-pc        (opcional no modo Git: só nomeia os commits)
